# BuyZO — Vercel env vars (Project: BuyZo, repo: namithakrishna368/BuyZo)
# Import: https://vercel.com/new → GitHub → BuyZo → Root Directory: .

# ─── Frontend (build) ───
VITE_API_URL=/api

# ─── Backend (runtime, used by api/index.js) ───
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/buyzo
JWT_SECRET=replace_with_long_random_string
JWT_EXPIRE=7d
NODE_ENV=production

CLIENT_URL=https://YOUR-BUYZO-URL.vercel.app
GOOGLE_CALLBACK_URL=https://YOUR-BUYZO-URL.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=BuyZO <noreply@buyzo.com>
