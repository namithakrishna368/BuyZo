# Copy these into Vercel → Project → Settings → Environment Variables
# Replace YOUR-APP with your deployment hostname (e.g. buy-zo.vercel.app)

# ─── Frontend service (Vite build) ───
VITE_API_URL=/_/backend/api

# ─── Backend service (runtime) ───
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/buyzo
JWT_SECRET=replace_with_long_random_string
JWT_EXPIRE=7d
NODE_ENV=production

CLIENT_URL=https://YOUR-APP.vercel.app
GOOGLE_CALLBACK_URL=https://YOUR-APP.vercel.app/_/backend/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=BuyZO <noreply@buyzo.com>

# Vercel auto-injects (do not set manually unless needed):
# VERCEL_URL, FRONTEND_URL, BACKEND_URL, VITE_BACKEND_URL
